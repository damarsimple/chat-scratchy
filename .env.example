# LLM API endpoint (proxied via Vite /api/chat → your LLM backend)
VITE_API_ENDPOINT=/api/chat/completions

# Backend API base URL (proxied via Vite /api → localhost:3500)
VITE_API_BASE=/api

# Default model name
VITE_DEFAULT_MODEL=gpt-3.5-turbo

# Optional API key (sent as Bearer token to the LLM endpoint)
# VITE_API_KEY=sk-your-key-here
